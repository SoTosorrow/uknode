{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "src",
    "outDir": "dist/server",
    "types": ["node"]
  },
  "include": ["src/app/backend", "src/runtime/server", "src/storage", "src/core"]
}
